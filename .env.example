# ---- Frontend (Vercel project env / frontend/.env.local) ----
# mock = runs entirely in the browser (default, investor demo); live = calls the Spring Boot API
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ---- Vercel serverless proxy (only for NEXT_PUBLIC_API_MODE=live) ----
BACKEND_URL=https://medlift-api.example.com

# ---- Backend (docker compose / Spring Boot) ----
AI_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=          # required only when AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
CORS_ALLOWED_ORIGINS=http://localhost:5173
